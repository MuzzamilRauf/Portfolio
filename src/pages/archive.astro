---
import Icon from "@/components/ui/Icon.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getArchiveProjects } from "@/lib/content";

const projects = await getArchiveProjects();
const th =
  "px-2.5 py-2.5 text-left font-mono text-[13px] font-normal text-heading md:px-4";
const td = "px-2.5 py-3 align-top md:px-4";
---

<BaseLayout title="Archive" description="A big list of things I've worked on.">
  <div class="container-page pb-24">
    <PageHeader title="Archive" subtitle="A big list of things I've worked on" />

    <table class="w-full border-collapse text-[17px]">
      <caption class="sr-only">All projects, newest first</caption>
      <thead>
        <tr class="border-b border-line">
          <th scope="col" class:list={[th, "w-20"]}>Year</th>
          <th scope="col" class={th}>Title</th>
          <th scope="col" class:list={[th, "hidden lg:table-cell"]}>Made at</th>
          <th scope="col" class:list={[th, "hidden md:table-cell"]}>Built with</th>
          <th scope="col" class={th}><span class="sr-only">Links</span></th>
        </tr>
      </thead>
      <tbody>
        {
          projects.map(({ data }) => (
            <tr class="transition-colors hover:bg-surface">
              <td class:list={[td, "font-mono text-sm text-accent"]}>{data.date.getUTCFullYear()}</td>
              <td class:list={[td, "font-semibold text-heading"]}>{data.title}</td>
              <td class:list={[td, "hidden text-sm lg:table-cell"]}>{data.company ?? "—"}</td>
              <td class:list={[td, "hidden font-mono text-xs leading-relaxed md:table-cell"]}>
                {data.tech.join(" · ")}
              </td>
              <td class={td}>
                <div class="flex items-center justify-end gap-1">
                  {data.github && (
                    <a
                      href={data.github}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${data.title} on GitHub`}
                      class="p-1.5 text-fg transition-colors hover:text-accent"
                    >
                      <Icon name="github" class="size-5" />
                    </a>
                  )}
                  {data.external && (
                    <a
                      href={data.external}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${data.title} live site`}
                      class="p-1.5 text-fg transition-colors hover:text-accent"
                    >
                      <Icon name="external" class="size-5" />
                    </a>
                  )}
                </div>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</BaseLayout>
