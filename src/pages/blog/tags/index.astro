---
import PageHeader from "@/components/ui/PageHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getTags, tagSlug } from "@/lib/content";

const tags = await getTags();
---

<BaseLayout title="Tags" description="Blog posts grouped by topic.">
  <div class="container-page mx-auto max-w-[1100px] pb-24">
    <PageHeader title="Tags" subtitle="Browse posts by topic">
      <a href="/blog" class="mt-6 inline-block font-mono text-[13px] text-fg hover:text-accent">← All posts</a>
    </PageHeader>
    <ul class="flex flex-wrap gap-3">
      {
        tags.map(([tag, count]) => (
          <li>
            <a
              href={`/blog/tags/${tagSlug(tag)}`}
              class="inline-flex items-center gap-2 rounded border border-line px-4 py-2.5 font-mono text-sm text-fg transition-colors hover:border-accent hover:text-accent"
            >
              #{tag}
              <span class="text-xs text-muted">{count}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
