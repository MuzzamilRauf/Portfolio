---
import PostList from "@/components/blog/PostList.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPosts, getTags, tagSlug } from "@/lib/content";

export async function getStaticPaths() {
  const [tags, posts] = await Promise.all([getTags(), getPosts()]);
  return tags.map(([tag]) => ({
    params: { tag: tagSlug(tag) },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

const { tag, posts } = Astro.props;
const count = `${posts.length} post${posts.length === 1 ? "" : "s"}`;
---

<BaseLayout title={`#${tag}`} description={`Blog posts tagged ${tag}.`}>
  <div class="container-page mx-auto max-w-[1100px] pb-24">
    <PageHeader title={`#${tag}`} subtitle={count}>
      <p class="mt-6 flex flex-wrap gap-x-6 font-mono text-[13px]">
        <a href="/blog" class="text-fg hover:text-accent">← All posts</a>
        <a href="/blog/tags" class="text-fg hover:text-accent">All tags</a>
      </p>
    </PageHeader>
    <PostList posts={posts} />
  </div>
</BaseLayout>
