---
import { render } from "astro:content";
import TagLinks from "@/components/blog/TagLinks.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatDate, getPosts, readingTime } from "@/lib/content";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, updated, tags } = post.data;
---

<BaseLayout title={title} description={description}>
  <article class="container-page mx-auto max-w-[800px] pb-24">
    <header class="pt-12 pb-10 md:pt-20">
      <a href="/blog" class="font-mono text-sm text-accent hover:underline">← All posts</a>
      <h1
        class="mt-6 text-[clamp(2.25rem,6vw,3.75rem)] leading-[1.1] tracking-tight"
        transition:name={`post-title-${post.id}`}
      >
        {title}
      </h1>
      <p class="mt-5 font-mono text-[13px]">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {
          updated && (
            <>
              {" "}
              · updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time>
            </>
          )
        }{" "}
        · {readingTime(post.body)}
      </p>
      <TagLinks tags={tags} class="mt-3" />
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
