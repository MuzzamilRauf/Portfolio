---
import About from "@/components/sections/About.astro";
import Experience from "@/components/sections/Experience.astro";
import Hero from "@/components/sections/Hero.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  getArchiveProjects,
  getFeaturedProjects,
  getGridProjects,
  getPosts,
  getTags,
} from "@/lib/content";

// TEMPORARY: data for the "content check" block below, removed as Phase 4 sections land.
const [featured, grid, archive, posts, postTags] = await Promise.all([
  getFeaturedProjects(),
  getGridProjects(),
  getArchiveProjects(),
  getPosts(),
  getTags(),
]);
---

<BaseLayout intro>
  <Hero />
  <About />
  <Experience />

  <div class="container-page">
    <section class="mx-auto max-w-[1000px] space-y-6 py-24 text-[17px]">
      <SectionHeading number={0}>Content check (temporary)</SectionHeading>
      <div>
        <p class="font-mono text-sm text-accent">
          Projects: featured {featured.length} · grid {grid.length} · archive {archive.length}
        </p>
        <ul>{featured.map((p) => <li>★ {p.data.title}</li>)}</ul>
        <ul>{grid.map((p) => <li>{p.data.title}</li>)}</ul>
      </div>
      <div>
        <p class="font-mono text-sm text-accent">Posts ({posts.length})</p>
        <ul>{posts.map((p) => <li>{p.data.title}</li>)}</ul>
        <p class="font-mono text-xs">
          Tags: {postTags.map(([tag, count]) => `${tag} (${count})`).join(", ")}
        </p>
      </div>
    </section>
  </div>
</BaseLayout>
