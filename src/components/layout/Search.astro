---
// Ctrl/⌘+K command palette. The index (/search.json) is fetched the first time it opens.
// `transition:persist` keeps the same dialog (and loaded index) across page navigations.
import Icon from "@/components/ui/Icon.astro";
---

<dialog
  id="search"
  aria-label="Search"
  transition:persist="search"
  class="search m-0 mx-auto mt-[12vh] w-[min(640px,calc(100%-2rem))] max-w-none overflow-hidden rounded-lg border border-line bg-surface p-0 text-fg shadow-[0_20px_50px_-15px_var(--shadow)]"
>
  <div class="flex items-center gap-3 border-b border-line px-4">
    <Icon name="search" class="size-5 shrink-0 text-accent" />
    <input
      type="text"
      role="combobox"
      aria-label="Search projects, posts, and pages"
      aria-autocomplete="list"
      aria-controls="search-results"
      aria-expanded="true"
      autocomplete="off"
      spellcheck="false"
      placeholder="Search projects, posts, pages…"
      class="h-14 min-w-0 flex-1 bg-transparent text-base text-heading placeholder:text-muted focus:outline-none"
    />
    <kbd class="hidden rounded border border-line px-1.5 py-0.5 font-mono text-[11px] sm:block">Esc</kbd>
  </div>
  <ul id="search-results" role="listbox" aria-label="Results" class="max-h-[min(60vh,420px)] overflow-y-auto p-2">
  </ul>
  <p data-search-status aria-live="polite" class="sr-only"></p>
  <div class="hidden gap-4 border-t border-line px-4 py-2.5 font-mono text-[11px] sm:flex">
    <span><kbd>↑</kbd> <kbd>↓</kbd> navigate</span>
    <span><kbd>↵</kbd> open</span>
    <span><kbd>esc</kbd> close</span>
  </div>
</dialog>

<style>
  .search {
    opacity: 0;
    scale: 0.97;
    transition:
      opacity 0.15s,
      scale 0.15s var(--ease-v4),
      display 0.15s allow-discrete,
      overlay 0.15s allow-discrete;
  }

  .search[open] {
    opacity: 1;
    scale: 1;
  }

  .search::backdrop {
    background: rgb(2 12 27 / 0.6);
    backdrop-filter: blur(3px);
  }

  @starting-style {
    .search[open] {
      opacity: 0;
      scale: 0.97;
    }
  }

  :global(html:has(dialog.search[open])) {
    overflow: hidden;
  }
</style>

<script>
  import { navigate } from "astro:transitions/client";
  import { type IconName, iconPaths } from "@/components/ui/icons";
  import type { SearchItem } from "@/lib/search";

  const TYPE_ICON: Record<SearchItem["type"], IconName> = {
    page: "file",
    project: "folder",
    post: "file",
    tag: "hash",
  };
  const TYPE_LABEL: Record<SearchItem["type"], string> = {
    page: "Page",
    project: "Project",
    post: "Post",
    tag: "Tag",
  };

  const dialog = document.getElementById("search") as HTMLDialogElement;
  const input = dialog.querySelector("input") as HTMLInputElement;
  const list = dialog.querySelector("#search-results") as HTMLUListElement;
  const status = dialog.querySelector("[data-search-status]") as HTMLElement;

  let index: SearchItem[] | null = null;
  let results: SearchItem[] = [];
  let active = 0;

  async function loadIndex() {
    if (index) return index;
    try {
      const res = await fetch("/search.json");
      index = (await res.json()) as SearchItem[];
    } catch {
      index = [];
    }
    return index;
  }

  // Every word must match somewhere; title matches rank above description/keyword matches.
  function search(query: string, items: SearchItem[]) {
    const terms = query.toLowerCase().split(/\s+/).filter(Boolean);
    if (terms.length === 0) return items.filter((i) => i.type !== "tag").slice(0, 8);
    return items
      .map((item) => {
        const title = item.title.toLowerCase();
        const rest = `${item.description ?? ""} ${item.keywords ?? ""}`.toLowerCase();
        let score = 0;
        for (const term of terms) {
          if (title.startsWith(term)) score += 3;
          else if (title.includes(term)) score += 2;
          else if (rest.includes(term)) score += 1;
          else return null;
        }
        return { item, score };
      })
      .filter((r): r is { item: SearchItem; score: number } => r !== null)
      .sort((a, b) => b.score - a.score)
      .slice(0, 10)
      .map((r) => r.item);
  }

  function icon(name: IconName) {
    const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
    svg.setAttribute("viewBox", "0 0 24 24");
    svg.setAttribute("fill", "none");
    svg.setAttribute("stroke", "currentColor");
    svg.setAttribute("stroke-width", "1.8");
    svg.setAttribute("stroke-linecap", "round");
    svg.setAttribute("stroke-linejoin", "round");
    svg.setAttribute("aria-hidden", "true");
    svg.setAttribute("class", "size-[18px] shrink-0 text-accent");
    svg.innerHTML = iconPaths[name];
    return svg;
  }

  function render() {
    list.replaceChildren(
      ...results.map((item, i) => {
        const li = document.createElement("li");
        li.id = `search-opt-${i}`;
        li.setAttribute("role", "option");
        li.setAttribute("aria-selected", String(i === active));
        li.className =
          "flex cursor-pointer items-center gap-3 rounded px-3 py-2.5 aria-selected:bg-accent-soft aria-selected:text-accent";

        const text = document.createElement("div");
        text.className = "min-w-0 flex-1";
        const title = document.createElement("p");
        title.className = "truncate text-[15px] text-heading";
        title.textContent = item.title;
        text.append(title);
        if (item.description) {
          const desc = document.createElement("p");
          desc.className = "truncate text-[13px]";
          desc.textContent = item.description;
          text.append(desc);
        }
        const type = document.createElement("span");
        type.className = "font-mono text-[11px] text-muted";
        type.textContent = TYPE_LABEL[item.type];

        li.append(icon(TYPE_ICON[item.type]), text, type);
        li.addEventListener("mousemove", () => setActive(i, false));
        li.addEventListener("click", () => go(item));
        return li;
      }),
    );

    if (results.length === 0) {
      const empty = document.createElement("li");
      empty.className = "px-3 py-8 text-center text-[15px]";
      empty.textContent = `No results for “${input.value.trim()}”`;
      list.append(empty);
    }
    input.setAttribute("aria-activedescendant", results.length ? `search-opt-${active}` : "");
    status.textContent = input.value.trim()
      ? `${results.length} result${results.length === 1 ? "" : "s"}`
      : "";
  }

  function setActive(i: number, scroll = true) {
    if (i === active) return;
    list.querySelector(`#search-opt-${active}`)?.setAttribute("aria-selected", "false");
    active = i;
    const el = list.querySelector(`#search-opt-${active}`);
    el?.setAttribute("aria-selected", "true");
    input.setAttribute("aria-activedescendant", `search-opt-${active}`);
    if (scroll) el?.scrollIntoView({ block: "nearest" });
  }

  function go(item: SearchItem) {
    dialog.close();
    if (/^https?:\/\//.test(item.url)) window.open(item.url, "_blank", "noopener");
    else navigate(item.url);
  }

  async function open() {
    if (dialog.open) return;
    input.value = "";
    active = 0;
    dialog.showModal();
    input.focus();
    results = search("", await loadIndex());
    render();
  }

  input.addEventListener("input", async () => {
    active = 0;
    results = search(input.value, await loadIndex());
    render();
  });

  input.addEventListener("keydown", (e) => {
    if (e.key === "ArrowDown" && results.length) {
      e.preventDefault();
      setActive((active + 1) % results.length);
    } else if (e.key === "ArrowUp" && results.length) {
      e.preventDefault();
      setActive((active - 1 + results.length) % results.length);
    } else if (e.key === "Enter" && results[active]) {
      e.preventDefault();
      go(results[active]);
    }
  });

  // Click on the backdrop (outside the panel) closes it.
  dialog.addEventListener("click", (e) => {
    if (e.target === dialog) dialog.close();
  });

  document.addEventListener("keydown", (e) => {
    const typing = (e.target as HTMLElement).closest("input, textarea, [contenteditable]");
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
      e.preventDefault();
      dialog.open ? dialog.close() : open();
    } else if (e.key === "/" && !typing && !dialog.open) {
      e.preventDefault();
      open();
    }
  });

  // Any [data-search-open] button (nav, mobile) opens it; delegated so it survives navigation.
  document.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("[data-search-open]")) open();
  });
</script>
