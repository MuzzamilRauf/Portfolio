---
// Initials badge built from site.name.
import { site } from "@/config";

interface Props {
  class?: string;
}

const { class: className = "size-11" } = Astro.props;

const initials = site.name
  .split(/\s+/)
  .map((word) => word[0])
  .join("")
  .slice(0, 2)
  .toUpperCase();
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="none" class={className} aria-hidden="true">
  <rect x="3" y="3" width="42" height="42" rx="10" stroke="currentColor" stroke-width="2.5"></rect>
  <text
    x="24"
    y="30.5"
    text-anchor="middle"
    fill="currentColor"
    style="font-family: var(--font-mono)"
    font-size="17"
    font-weight="600">{initials}</text
  >
</svg>
