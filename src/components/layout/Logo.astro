---
// Initials badge built from site.name. `animated` is used by the intro loader.
import { site } from "@/config";

interface Props {
  class?: string;
  animated?: boolean;
}

const { class: className = "size-11", animated = false } = Astro.props;

const initials = site.name
  .split(/\s+/)
  .map((word) => word[0])
  .join("")
  .slice(0, 2)
  .toUpperCase();
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 48 48"
  fill="none"
  class:list={[className, animated && "logo-animated"]}
  aria-hidden="true"
>
  <rect
    class="logo-frame"
    x="3"
    y="3"
    width="42"
    height="42"
    rx="10"
    stroke="currentColor"
    stroke-width="2.5"
    pathLength="1"></rect>
  <text
    class="logo-text"
    x="24"
    y="30.5"
    text-anchor="middle"
    fill="currentColor"
    style="font-family: var(--font-mono)"
    font-size="17"
    font-weight="600">{initials}</text
  >
</svg>

<style>
  .logo-animated .logo-frame {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: logo-draw 1s var(--ease-v4) 0.2s forwards;
  }

  .logo-animated .logo-text {
    opacity: 0;
    animation: logo-fade 0.4s ease-out 1.1s forwards;
  }

  @keyframes logo-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes logo-fade {
    to {
      opacity: 1;
    }
  }
</style>
