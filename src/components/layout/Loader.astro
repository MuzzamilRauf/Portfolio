---
// Full-screen intro shown once per browser session on the home page.
// BaseLayout's head script adds `html.intro` (skipped for reduced motion); this hides it again.
import Logo from "@/components/layout/Logo.astro";
---

<div class="loader fixed inset-0 z-[100] hidden items-center justify-center bg-bg" aria-hidden="true">
  <Logo animated class="size-24 text-accent" />
</div>

<style>
  :global(html.intro) {
    overflow: hidden;
  }

  :global(html.intro) .loader {
    display: flex;
    animation: loader-out 0.4s var(--ease-v4) 1.9s forwards;
  }

  @keyframes loader-out {
    to {
      opacity: 0;
      transform: scale(1.08);
      visibility: hidden;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const loader = document.querySelector<HTMLElement>(".loader");

  function finish() {
    root.classList.remove("intro");
    try {
      sessionStorage.setItem("intro-seen", "1");
    } catch {}
  }

  if (root.classList.contains("intro") && loader) {
    loader.addEventListener("animationend", (e) => {
      if (e.target === loader) finish();
    });
    // Safety net in case animationend never fires (e.g. background tab).
    setTimeout(finish, 3000);
  }
</script>
