---
import { Image } from "astro:assets";
import headshot from "@/assets/headshot.png";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import { about } from "@/config";
---

<section id="about" class="container-page scroll-mt-24 py-16">
  <div class="mx-auto max-w-[1000px]">
    <SectionHeading>About</SectionHeading>
    <div class="grid gap-10 md:grid-cols-[1fr_220px]">
      <div class="space-y-4 text-[17px] leading-relaxed">
        {about.paragraphs.map((p) => <p>{p}</p>)}
        <p>Technologies I work with:</p>
        <ul class="flex flex-wrap gap-x-5 gap-y-1 font-mono text-[13px] text-fg">
          {about.skills.map((skill) => <li>{skill}</li>)}
        </ul>
      </div>
      <Image
        src={headshot}
        alt={about.headshotAlt}
        widths={[220, 440]}
        sizes="220px"
        class="w-44 rounded-lg border border-line md:w-full"
      />
    </div>
  </div>
</section>
