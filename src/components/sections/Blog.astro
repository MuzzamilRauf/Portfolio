---
import SectionHeading from "@/components/ui/SectionHeading.astro";
import { formatDate, getPosts } from "@/lib/content";

const posts = await getPosts();
---

<!-- Dated list of posts; each title opens a simple post page. -->
<section id="blog" class="container-page scroll-mt-24 py-16">
  <div class="mx-auto max-w-[1000px]">
    <SectionHeading>Blog</SectionHeading>
    {
      posts.length > 0 ? (
        <ul class="space-y-5">
          {posts.map((post) => (
            <li class="grid gap-x-6 gap-y-0.5 sm:grid-cols-[130px_1fr]">
              <time datetime={post.data.date.toISOString()} class="font-mono text-[13px] sm:pt-0.5">
                {formatDate(post.data.date)}
              </time>
              <div>
                <a
                  href={`/blog/${post.id}`}
                  class="text-lg font-semibold text-accent hover:underline"
                  transition:name={`post-title-${post.id}`}
                >
                  {post.data.title}
                </a>
                {post.data.draft && <span class="font-mono text-xs text-danger"> draft</span>}
                <p class="text-[17px] leading-relaxed">{post.data.description}</p>
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <p>No posts yet.</p>
      )
    }
    <p class="mt-8 font-mono text-[13px]">
      <a href="/rss.xml" class="text-fg hover:text-accent">RSS feed</a>
    </p>
  </div>
</section>
