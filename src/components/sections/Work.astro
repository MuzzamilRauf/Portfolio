---
import { Image } from "astro:assets";
import Icon from "@/components/ui/Icon.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import { getProjects } from "@/lib/content";

const projects = await getProjects();
---

<!-- Project list: thumbnail · linked name, short description, tech, links. -->
<section id="work" class="container-page scroll-mt-24 py-16">
  <div class="mx-auto max-w-[1000px]">
    <SectionHeading>Work</SectionHeading>
    <ul class="divide-y divide-line">
      {
        projects.map(({ data }) => {
          const href = data.external ?? data.github;
          return (
            <li class="flex gap-5 py-6 first:pt-0">
              {data.cover ? (
                <Image
                  src={data.cover}
                  alt={data.coverAlt ?? ""}
                  widths={[128, 256]}
                  sizes="128px"
                  class="aspect-[4/3] w-24 shrink-0 rounded-md border border-line object-cover sm:w-32"
                />
              ) : (
                <span
                  aria-hidden="true"
                  class="flex aspect-[4/3] w-24 shrink-0 items-center justify-center rounded-md border border-line bg-surface text-accent sm:w-32"
                >
                  <Icon name="folder" class="size-8" />
                </span>
              )}
              <div class="min-w-0 flex-1">
                <h3 class="text-lg font-semibold">
                  {href ? (
                    <a href={href} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">
                      {data.title}
                    </a>
                  ) : (
                    data.title
                  )}
                </h3>
                <p class="mt-1 text-[17px] leading-relaxed">{data.summary}</p>
                <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-xs">
                  {data.tech.length > 0 && <span>{data.tech.join(" · ")}</span>}
                  {data.github && (
                    <a
                      href={data.github}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1 text-fg hover:text-accent"
                    >
                      <Icon name="github" class="size-3.5" /> code
                    </a>
                  )}
                  {data.external && (
                    <a
                      href={data.external}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1 text-fg hover:text-accent"
                    >
                      <Icon name="external" class="size-3.5" /> live
                    </a>
                  )}
                </div>
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
