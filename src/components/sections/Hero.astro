---
import { hero, site } from "@/config";
---

<section class="container-page">
  <div
    class="mx-auto flex min-h-[calc(100dvh-100px)] max-w-[1000px] flex-col items-start justify-center gap-5 pb-24"
  >
    <p class="font-mono text-sm text-accent md:text-base">{hero.greeting}</p>
    <h1 class="font-display text-[clamp(2.5rem,8vw,5rem)] leading-[1.1] tracking-tight">{site.name}.</h1>
    <p
      class="font-display text-[clamp(2.5rem,8vw,5rem)] leading-[1.1] font-semibold tracking-tight text-muted"
    >
      {hero.headline}
    </p>
    <p class="max-w-[540px] pt-2 font-display">{hero.intro}</p>
    <div class="flex flex-wrap gap-4 pt-8">
      <a
        href="/#work"
        class="inline-block rounded border border-accent px-7 py-5 font-mono text-sm leading-none text-accent transition duration-250 ease-v4 hover:-translate-x-1 hover:-translate-y-1 hover:shadow-[4px_4px_0_0_var(--accent)]"
      >
        Check out my work!
      </a>
      <a
        href={site.resume}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block rounded border border-line px-7 py-5 font-mono text-sm leading-none text-fg transition duration-250 ease-v4 hover:border-accent hover:text-accent"
      >
        Resume
      </a>
    </div>
  </div>
</section>
