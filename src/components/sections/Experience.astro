---
import { render } from "astro:content";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import { formatRange, getJobs } from "@/lib/content";

const jobs = await Promise.all(
  (await getJobs()).map(async (job) => ({
    job,
    Content: (await render(job)).Content,
  })),
);
---

<section id="experience" class="container-page scroll-mt-24 py-24">
  <div class="reveal mx-auto max-w-[700px]">
    <SectionHeading number={2}>Where I've Worked</SectionHeading>

    <!-- ARIA tabs: vertical on desktop, horizontally scrollable on mobile. -->
    <div data-tabs class="flex flex-col gap-6 md:flex-row md:gap-8">
      <div
        role="tablist"
        aria-label="Jobs"
        class="relative -mx-6 flex shrink-0 overflow-x-auto px-6 md:mx-0 md:flex-col md:overflow-visible md:px-0"
        style="--i: 0"
      >
        {
          jobs.map(({ job }, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${job.id}`}
              aria-controls={`panel-${job.id}`}
              aria-selected={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? 0 : -1}
              class="h-[42px] w-[120px] shrink-0 border-b-2 border-line px-5 font-mono text-[13px] whitespace-nowrap transition-colors duration-250 ease-v4 hover:bg-surface hover:text-accent aria-selected:text-accent md:w-auto md:border-b-0 md:border-l-2 md:text-left"
            >
              {job.data.company}
            </button>
          ))
        }
        <span
          aria-hidden="true"
          class="absolute bottom-0 left-6 h-0.5 w-[120px] translate-x-[calc(var(--i)*120px)] bg-accent transition-transform delay-100 duration-250 ease-v4 md:top-0 md:left-0 md:h-[42px] md:w-0.5 md:translate-x-0 md:translate-y-[calc(var(--i)*42px)]"
        >
        </span>
      </div>

      <div class="min-w-0 flex-1">
        {
          jobs.map(({ job, Content }, i) => (
            <div
              role="tabpanel"
              id={`panel-${job.id}`}
              aria-labelledby={`tab-${job.id}`}
              tabindex="0"
              hidden={i !== 0}
              class="panel py-1"
            >
              <h3 class="text-xl font-medium md:text-[22px]">
                {job.data.title}
                <span class="text-accent">
                  {" "}
                  @{" "}
                  {job.data.url ? (
                    <a
                      href={job.data.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="underline decoration-transparent underline-offset-4 transition duration-250 hover:decoration-accent"
                    >
                      {job.data.company}
                    </a>
                  ) : (
                    job.data.company
                  )}
                </span>
              </h3>
              <p class="mt-1 mb-6 font-mono text-[13px]">
                {formatRange(job.data.start, job.data.end)}
                {job.data.location && <span> · {job.data.location}</span>}
              </p>
              <div class="job-body text-[17px] leading-relaxed">
                <Content />
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .job-body :global(ul) {
    display: grid;
    gap: 0.75rem;
  }

  .job-body :global(li) {
    position: relative;
    padding-left: 1.75rem;
  }

  .job-body :global(li)::before {
    content: "▹";
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  .panel:not([hidden]) {
    animation: panel-in 0.3s var(--ease-v4);
  }

  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
</style>

<script>
  // Tabs pattern from the WAI-ARIA Authoring Practices: arrow keys move between tabs
  // (both axes, since the list is vertical on desktop and horizontal on mobile), Home/End jump.
  function initTabs() {
    for (const root of document.querySelectorAll<HTMLElement>("[data-tabs]")) {
      if (root.dataset.bound) continue;
      root.dataset.bound = "true";

      const list = root.querySelector<HTMLElement>('[role="tablist"]');
      const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      if (!list) continue;

      const select = (index: number, focus = false) => {
        tabs.forEach((tab, i) => {
          const selected = i === index;
          tab.setAttribute("aria-selected", String(selected));
          tab.tabIndex = selected ? 0 : -1;
          const panel = document.getElementById(tab.getAttribute("aria-controls") ?? "");
          if (panel) panel.hidden = !selected;
        });
        list.style.setProperty("--i", String(index));
        if (focus) tabs[index].focus();
        tabs[index].scrollIntoView({ block: "nearest", inline: "nearest" });
      };

      tabs.forEach((tab, i) => {
        tab.addEventListener("click", () => select(i));
      });

      list.addEventListener("keydown", (e) => {
        const current = tabs.indexOf(document.activeElement as HTMLButtonElement);
        if (current === -1) return;
        const last = tabs.length - 1;
        const next: Record<string, number> = {
          ArrowDown: current === last ? 0 : current + 1,
          ArrowRight: current === last ? 0 : current + 1,
          ArrowUp: current === 0 ? last : current - 1,
          ArrowLeft: current === 0 ? last : current - 1,
          Home: 0,
          End: last,
        };
        if (e.key in next) {
          e.preventDefault();
          select(next[e.key], true);
        }
      });
    }
  }

  initTabs();
  document.addEventListener("astro:page-load", initTabs);
</script>
