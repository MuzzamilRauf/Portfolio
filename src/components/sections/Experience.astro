---
import { Image } from "astro:assets";
import { render } from "astro:content";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import { formatYears, getJobs } from "@/lib/content";

const jobs = await Promise.all(
  (await getJobs()).map(async (job) => ({
    job,
    Content: (await render(job)).Content,
  })),
);
---

<!-- Timeline: years · logo · role and a short description. -->
<section id="experience" class="container-page scroll-mt-24 py-16">
  <div class="mx-auto max-w-[1000px]">
    <SectionHeading>Experience</SectionHeading>
    <ol class="divide-y divide-line">
      {
        jobs.map(({ job, Content }) => {
          const { company, title, url, location, logo, start, end } = job.data;
          return (
            <li class="grid grid-cols-[48px_1fr] gap-x-4 gap-y-1 py-6 first:pt-0 sm:grid-cols-[130px_48px_1fr]">
              <p class="col-span-2 font-mono text-[13px] text-accent sm:col-span-1 sm:pt-3">
                {formatYears(start, end)}
              </p>
              {logo ? (
                <Image src={logo} alt="" width={96} class="size-12 rounded-md border border-line object-cover" />
              ) : (
                <span
                  aria-hidden="true"
                  class="flex size-12 items-center justify-center rounded-md border border-line bg-surface font-mono text-lg text-accent"
                >
                  {company[0]}
                </span>
              )}
              <div class="min-w-0">
                <h3 class="text-lg font-semibold">
                  {title} ·{" "}
                  {url ? (
                    <a href={url} target="_blank" rel="noopener noreferrer" class="text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent">
                      {company}
                    </a>
                  ) : (
                    company
                  )}
                </h3>
                {location && <p class="font-mono text-xs">{location}</p>}
                <div class="mt-2 text-[17px] leading-relaxed">
                  <Content />
                </div>
              </div>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>
