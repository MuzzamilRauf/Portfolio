---
import SectionHeading from "@/components/ui/SectionHeading.astro";
import { contact, site } from "@/config";
---

<section id="contact" class="container-page scroll-mt-24 pt-16 pb-24">
  <div class="mx-auto max-w-[1000px]">
    <SectionHeading>Contact</SectionHeading>
    <p class="max-w-[600px] text-[17px] leading-relaxed">{contact.text}</p>
    <a
      href={`mailto:${site.email}`}
      class="mt-6 inline-block rounded border border-accent px-7 py-4 font-mono text-sm leading-none text-accent transition duration-250 ease-v4 hover:bg-accent-soft"
    >
      {site.email}
    </a>
  </div>
</section>
