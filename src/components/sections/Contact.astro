---
import { site } from "@/config";

const action = site.formspreeId
  ? `https://formspree.io/f/${site.formspreeId}`
  : undefined;

const field =
  "w-full rounded border border-line bg-surface px-4 py-3 text-base text-heading placeholder:text-muted/70 transition-colors duration-250 focus:border-accent focus:outline-none aria-invalid:border-danger";
const label = "mb-2 block font-mono text-[13px] text-fg";
const error = "mt-1.5 hidden font-mono text-xs text-danger";
---

<section id="contact" class="container-page scroll-mt-24 py-24 md:py-32">
  <div class="reveal mx-auto max-w-[600px] text-center">
    <p class="mb-5 font-mono text-base text-accent">05. What's Next?</p>
    <h2 class="mb-5 text-[clamp(2.5rem,5vw,3.75rem)] leading-tight">Get In Touch</h2>
    <p class="mb-12">
      Placeholder: my inbox is always open. Whether you have a question or just want to say hi, send
      a message below or email me at{" "}
      <a
        href={`mailto:${site.email}`}
        class="text-accent underline decoration-transparent underline-offset-4 transition duration-250 hover:decoration-accent"
        >{site.email}</a
      >.
    </p>

    <form
      data-contact
      action={action}
      method="POST"
      novalidate
      class="space-y-5 text-left"
      data-email={site.email}
    >
      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="contact-name" class={label}>Name</label>
          <input
            id="contact-name"
            name="name"
            type="text"
            required
            autocomplete="name"
            aria-describedby="contact-name-error"
            class={field}
          />
          <p id="contact-name-error" class={error}>Please enter your name.</p>
        </div>
        <div>
          <label for="contact-email" class={label}>Email</label>
          <input
            id="contact-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            aria-describedby="contact-email-error"
            class={field}
          />
          <p id="contact-email-error" class={error}>Please enter a valid email address.</p>
        </div>
      </div>
      <div>
        <label for="contact-message" class={label}>Message</label>
        <textarea
          id="contact-message"
          name="message"
          required
          minlength="10"
          rows="5"
          aria-describedby="contact-message-error"
          class:list={[field, "resize-y"]}></textarea>
        <p id="contact-message-error" class={error}>Please write at least 10 characters.</p>
      </div>
      <!-- Honeypot: bots fill it in, people never see it. Formspree drops those submissions. -->
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

      <div class="flex flex-col items-center gap-4 pt-4">
        <button
          type="submit"
          class="rounded border border-accent px-8 py-5 font-mono text-sm leading-none text-accent transition duration-250 ease-v4 hover:bg-accent-soft disabled:cursor-wait disabled:opacity-60"
        >
          Say Hello
        </button>
        <p data-status role="status" aria-live="polite" class="min-h-6 text-center font-mono text-sm">
        </p>
      </div>
    </form>
  </div>
</section>

<script>
  function initContact() {
    const form = document.querySelector<HTMLFormElement>("form[data-contact]");
    if (!form || form.dataset.bound) return;
    form.dataset.bound = "true";

    const status = form.querySelector<HTMLElement>("[data-status]");
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const fields = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("[required]")];

    const setStatus = (text: string, tone: "ok" | "error" | "info") => {
      if (!status) return;
      status.textContent = text;
      status.classList.toggle("text-accent", tone === "ok");
      status.classList.toggle("text-danger", tone === "error");
    };

    // Show a field's error only after the visitor has interacted with it (or tried to submit).
    const check = (el: HTMLInputElement | HTMLTextAreaElement) => {
      const valid = el.value.trim() !== "" && el.checkValidity();
      el.setAttribute("aria-invalid", String(!valid));
      document.getElementById(`${el.id}-error`)?.classList.toggle("hidden", valid);
      return valid;
    };
    for (const el of fields) {
      el.addEventListener("blur", () => el.value && check(el));
      el.addEventListener("input", () => el.getAttribute("aria-invalid") === "true" && check(el));
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const invalid = fields.filter((el) => !check(el));
      if (invalid.length) {
        invalid[0].focus();
        setStatus("Please fix the highlighted fields.", "error");
        return;
      }
      if (!form.getAttribute("action")) {
        setStatus(`The form isn't connected yet — please email ${form.dataset.email}.`, "info");
        return;
      }

      button?.setAttribute("disabled", "");
      if (button) button.textContent = "Sending…";
      setStatus("", "info");
      try {
        const res = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        for (const el of fields) el.removeAttribute("aria-invalid");
        setStatus("Thanks! Your message was sent — I'll get back to you soon.", "ok");
      } catch {
        setStatus(`Something went wrong. Please try again or email ${form.dataset.email}.`, "error");
      } finally {
        button?.removeAttribute("disabled");
        if (button) button.textContent = "Say Hello";
      }
    });
  }

  initContact();
  document.addEventListener("astro:page-load", initContact);
</script>
