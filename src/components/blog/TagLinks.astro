---
import { tagSlug } from "@/lib/content";

interface Props {
  tags: string[];
  class?: string;
}

const { tags, class: className } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class:list={["flex flex-wrap gap-x-3 gap-y-1 font-mono text-xs", className]}>
      {tags.map((tag) => (
        <li>
          <a href={`/blog/tags/${tagSlug(tag)}`} class="relative z-10 text-accent hover:underline">
            #{tag}
          </a>
        </li>
      ))}
    </ul>
  )
}
