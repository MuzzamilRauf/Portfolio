---
import type { CollectionEntry } from "astro:content";
import TagLinks from "@/components/blog/TagLinks.astro";
import { formatDate, readingTime } from "@/lib/content";

interface Props {
  posts: CollectionEntry<"posts">[];
}

const { posts } = Astro.props;
---

<ul class="grid gap-4 md:grid-cols-2">
  {
    posts.map((post) => (
      <li class="group relative flex flex-col rounded bg-surface p-8 shadow-card transition duration-250 ease-v4 focus-within:-translate-y-1.5 hover:-translate-y-1.5">
        <p class="font-mono text-xs">
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time> ·{" "}
          {readingTime(post.body)}
          {post.data.draft && <span class="text-danger"> · draft</span>}
        </p>
        <h2
          class="mt-3 mb-3 text-2xl leading-snug transition-colors group-hover:text-accent"
          transition:name={`post-title-${post.id}`}
        >
          {/* The title link stretches over the whole card; tag links sit above it. */}
          <a href={`/blog/${post.id}`} class="after:absolute after:inset-0 after:rounded">
            {post.data.title}
          </a>
        </h2>
        <p class="mb-6 text-[17px] leading-relaxed">{post.data.description}</p>
        <TagLinks tags={post.data.tags} class="mt-auto" />
      </li>
    ))
  }
</ul>
