---
// Inherits size from `class` and color from `currentColor`.
import { type IconName, iconPaths } from "@/components/ui/icons";

interface Props {
  name: IconName;
  class?: string;
  title?: string;
}

const { name, class: className = "size-5", title } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden={title ? undefined : "true"}
  role={title ? "img" : undefined}
>
  {title && <title>{title}</title>}
  <Fragment set:html={iconPaths[name]} />
</svg>
