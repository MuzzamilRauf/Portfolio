---
// Big title + subtitle at the top of the archive, blog, and tag pages.
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<header class="mb-16 pt-12 md:pt-20">
  <h1 class="text-[clamp(2.5rem,8vw,5rem)] leading-[1.1] tracking-tight">{title}</h1>
  {subtitle && <p class="mt-3 font-mono text-sm text-accent md:text-base">{subtitle}</p>}
  <slot />
</header>
